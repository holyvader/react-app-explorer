{
  "name": "react-app-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "scan": "bun packages/scanner/src/cli.ts",
    "dev": "bun --filter @rae/viewer dev",
    "build": "bun --filter @rae/viewer build",
    "test": "bun test packages/scanner packages/viewer/test",
    "lint": "oxlint",
    "typecheck": "tsc -p packages/schema --noEmit && tsc -p packages/scanner --noEmit && tsc -p packages/design-system --noEmit && tsc -p packages/viewer --noEmit && tsc -p packages/server --noEmit",
    "desktop:dev": "bun --filter @rae/desktop dev",
    "desktop:build": "bun --filter @rae/desktop build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^1.89.0",
    "typescript": "7.1.0-beta"
  }
}
